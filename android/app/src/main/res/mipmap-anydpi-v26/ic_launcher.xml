<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon. The foreground is the vector layer generated by
    scripts/generate-icons.ps1 (open mushaf + Rub el Hizb star), the background is the
    matching emerald gradient, so the icon stays crisp at every launcher size instead of
    being resampled from a fixed PNG.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
