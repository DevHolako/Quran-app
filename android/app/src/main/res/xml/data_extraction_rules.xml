<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup is disabled in the manifest (android:allowBackup="false"), so nothing should
    ever reach a cloud backup or a device-to-device transfer. Both rule sets are
    restricted to the app's own private cache/data directories, which contain the
    bookmarks, reading position and downloaded recitations.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
