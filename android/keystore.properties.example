# Template for the release signing material. Copy to keystore.properties (which is
# git-ignored) and fill in the real values:
#
#   copy keystore.properties.example keystore.properties
#
# android/app/build.gradle refuses to build a *release* APK unless every value below is
# present. It will not fall back to the Android debug keystore, because that key is
# generated locally with a well-known password: anyone who unpacked such a build could
# sign future updates of this app.
#
# storeFile is resolved relative to the android/ directory.

storeFile=quran-release.jks
storePassword=
keyAlias=quran-release
keyPassword=

# versionCode and versionName do NOT belong here. Both are derived from the version in
# package.json (1.4.2 -> versionCode 10402), which is the only place a release is
# versioned. The in-app updater refuses to install a build that is not strictly newer
# than the running one, so a forgotten bump means the release is rejected by the very
# installs it is meant to reach.
#
# Only set these to override package.json for a one-off build:
# versionCode=10402
# versionName=1.4.2
